# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Embedding model used by src/run.py (local Sentence Transformers, no API key needed).
# Either a Hugging Face id (google/embeddinggemma-300m, gated: accept its licence first)
# or a local folder. Leave empty to use ../../models/embeddinggemma-300m next to the repo.
EMBEDDING_MODEL=google/embeddinggemma-300m

# Not used by this pipeline; only needed if you switch to an API provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
